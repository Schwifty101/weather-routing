# Settings are read from real environment variables (export them, or set them in your host's
# dashboard). Django does not load .env files. Every value below has a working default.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
DJANGO_BEHIND_PROXY=false          # true when TLS terminates at a proxy (Render, Fly, Heroku...)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_THROTTLE_RATE=120/min
API_NUM_PROXIES=                   # number of trusted proxies in front of the app (Render: 1)

# --- Providers ---
PROVIDERS=live                     # "fake" = deterministic offline demo data (no network needed)
OSRM_BASE_URL=https://router.project-osrm.org   # point at your own OSRM for production use
PHOTON_URL=https://photon.komoot.io/api/
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# --- Behaviour ---
TRUCK_DURATION_FACTOR=1.10         # OSRM's public profile is a car; scale durations for a loaded truck
WIND_METRIC=sustained              # or "gust" to classify on hourly gusts
FORECAST_DAYS=7
WEATHER_CACHE_SECONDS=1800
HTTP_TIMEOUT_SECONDS=25
LOG_LEVEL=INFO
